# Copie para .env.local e preencha. Nunca commite o .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor e scripts. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Usado por `npm run seed` para convidar o admin.
ADMIN_EMAIL=comercial.servicoaki@gmail.com

# Juma Entregas (plataforma Machine, API v2). Somente servidor; sem elas a taxa
# de entrega fica "a combinar". Login = usuário Gestor da empresa Cake 67.
MACHINE_API_URL=https://api.taximachine.com.br/api/v2/integracao
MACHINE_API_KEY=
MACHINE_USERNAME=
MACHINE_PASSWORD=
