# Copie para .env.local e preencha. Nunca commite o .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor e scripts. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Usado por `npm run seed` para convidar o admin.
ADMIN_EMAIL=comercial.servicoaki@gmail.com

# Pagamento online (etapa 11): uma conta Stripe por loja, pelo apelido gravado
# em Lojas no painel ("loja1" -> STRIPE_LOJA1_*). Somente servidor. Sem as duas
# chaves, a loja fica só com WhatsApp.
# Use uma chave restrita (rk_) em vez da secreta (sk_), com só estas permissões:
# Checkout Sessions (escrita), PaymentIntents (leitura), Charges (leitura),
# Refunds (escrita). Na Vercel, cadastre como variável "Sensitive".
# STRIPE_LOJA1_SECRET_KEY=rk_test_...
# STRIPE_LOJA1_WEBHOOK_SECRET=whsec_...
# STRIPE_LOJA1_METHODS=card,pix   # opcional; "card" enquanto o Pix não estiver liberado
# STRIPE_LOJA2_SECRET_KEY=
# STRIPE_LOJA2_WEBHOOK_SECRET=
